# Virtual environments
env_new/
.venv/
venv/
env/
ENV/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Version control & IDE
.git/
.gitignore
.gitattributes
.github/
