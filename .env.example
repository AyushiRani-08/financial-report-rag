# =============================================================
# FinSight — Environment Configuration Template
# Copy this file to .env and fill in your values
# =============================================================

# LLM API Key (Required for RAG generation and summaries)
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=financial_rag

# DSN for local development outside Docker (pointing to localhost)
POSTGRES_DSN=postgresql://postgres:password@localhost:5432/financial_rag
