# FinSight — .gitignore
# ══════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl
*.spec

# ── Virtual environments ──────────────────────────────────────
venv/
.venv/
env/
ENV/
env_new/
.Python

# ── Environment & Secrets ─────────────────────────────────────
.env
.env.local
.env.*.local
.streamlit/secrets.toml

# ── Project data (large / generated / sensitive) ──────────────
# Raw filing downloads (can be large — 50-200 MB per filing)
data/raw_pdfs/*
!data/raw_pdfs/.gitkeep

# Parsed text output
data/parsed/*
!data/parsed/.gitkeep

# XBRL intermediate files
data/xbrl/*
!data/xbrl/.gitkeep

# Vector store (ChromaDB — hundreds of MBs, machine-specific)
data/chroma_db/

# Legacy index formats
data/bm25.pkl
data/qdrant_storage/

# Downloaded SEC filings (HTML/HTM are usually huge)
*.html
*.htm

# ── Logs & audit trails ───────────────────────────────────────
# Keep the directory tracked but not the log files themselves
logs/*
!logs/.gitkeep

# ── Evaluation results ────────────────────────────────────────
# Individual run JSONs are machine-generated — don't commit them
eval/results/*
!eval/results/.gitkeep

# ── Database files ────────────────────────────────────────────
*.sqlite3
*.db

# ── Streamlit cache ───────────────────────────────────────────
.streamlit/*.sqlite3

# ── Docker overrides ─────────────────────────────────────────
docker-compose.override.yml

# ── IDE & OS metadata ─────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# ── Deployment platforms ──────────────────────────────────────
.railway/
.fly/
